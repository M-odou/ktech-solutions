# URL publique du site (canonical, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=https://www.ktechsolutions.co

# Base de données : fichier SQLite local, ou Turso/libSQL en production
DATABASE_URL=file:./storage/ktech.db
DATABASE_AUTH_TOKEN=

# Dossier des fichiers envoyés (images des réalisations, documents des demandes)
STORAGE_DIR=./storage

# Vercel Blob (production sur Vercel) : si renseigné, les fichiers sont stockés dans Blob au lieu du disque
BLOB_READ_WRITE_TOKEN=

# Secret de signature des sessions (obligatoire en production) : openssl rand -base64 32
SESSION_SECRET=

# Premier compte administrateur (créé par npm run db:seed)
ADMIN_EMAIL=admin@ktechsolutions.co
ADMIN_PASSWORD=
